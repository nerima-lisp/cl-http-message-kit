(in-package #:http-message-kit)

(defmacro define-status-reasons (&body entries)
  (let ((seen nil)
        (normalized nil))
    (dolist (entry entries)
      (unless (and (consp entry)
                   (listp (cdr entry))
                   (= (length entry) 2))
        (error "Status entries must be (STATUS REASON) lists: ~S" entry))
      (destructuring-bind (status reason) entry
        (unless (and (integerp status) (<= 100 status 599))
          (error "HTTP status must be an integer in [100, 599]: ~S" status))
        (when (member status seen)
          (error "HTTP status appears more than once: ~S" status))
        (push status seen)
        (unless (or (null reason) (stringp reason))
          (error "HTTP status reason must be a string or NIL: ~S" reason))
        (push `(,status . ,reason) normalized)))
    `(defparameter *http-status-reasons* ',(nreverse normalized))))
